{
  "name": "dsh-minicad",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "面向 DSH agent 的参数化零件工作台",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./tools": "./src/host/tools.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host",
    "src/kernel",
    "src/client",
    "src/shared",
    "scripts/build.mjs",
    "scripts/dev.mjs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "docs/licenses",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bundleDependencies": [
    "@classcad/smlibwasm",
    "@deepseek-ai/schemastery",
    "fflate",
    "three"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "setup": "npm run build",
    "dev": "node scripts/dev.mjs",
    "check": "node --check src/host/index.js && node --check src/host/tools.js && node --check src/kernel/store.js && node --check src/kernel/model.js && node --check src/kernel/inspection.js && node --check src/shared/cad-schema.js && npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@classcad/smlibwasm": "0.6.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "fflate": "0.8.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
