{
  "name": "dsh-minicad",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "description": "Exact CAD modeling, inspection and revision history for DeepSeek Harness agents.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cad",
    "direct-modeling",
    "smlib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merc-hecl/dsh-minicad.git"
  },
  "homepage": "https://github.com/merc-hecl/dsh-minicad#readme",
  "bugs": {
    "url": "https://github.com/merc-hecl/dsh-minicad/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./tools": "./src/host/tools.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host",
    "src/kernel",
    "src/client",
    "src/shared",
    "scripts/build.mjs",
    "scripts/dev.mjs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "docs/*.md",
    "docs/images",
    "docs/licenses",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bundleDependencies": [
    "@classcad/smlibwasm",
    "@deepseek-ai/schemastery",
    "fflate",
    "three"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "setup": "npm run build",
    "dev": "node scripts/dev.mjs",
    "check": "node --check src/host/index.js && node --check src/host/tools.js && node --check src/host/worker.js && node --check src/host/model-open.js && node --check src/kernel/store.js && node --check src/kernel/process.js && node --check src/kernel/files.js && node --check src/kernel/model.js && node --check src/kernel/naming.js && node --check src/kernel/api.js && node --check src/kernel/inspection.js && node --check src/kernel/distances.js && node --check src/shared/cad-schema.js && node --check src/shared/preview.js && node --check src/shared/geometry-ids.js && node --check src/shared/geometry-annotations.js && node --check scripts/build.mjs && npm run build && node --check lib/client.js && node --check lib/workbench.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@classcad/smlibwasm": "0.6.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "fflate": "0.8.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "changelogen": "0.6.2",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
